{
  "name": "@patdx/ppkg",
  "version": "0.12.1",
  "description": "Install and manage binary packages on Linux and macOS",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^26.13.0"
  },
  "bin": {
    "ppkg": "dist/ppkg.js"
  },
  "exports": {
    "./install-binary": {
      "types": "./dist/types/install-binary.d.ts",
      "default": "./dist/ppkg.js"
    },
    "./resolve": {
      "types": "./dist/types/resolve.d.ts",
      "default": "./dist/ppkg.js"
    }
  },
  "files": [
    "dist/ppkg.js",
    "dist/types",
    "dist/THIRD_PARTY_LICENSES.txt",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.ts",
    "test": "pnpm run build && node --test dist/pkg/*.test.js dist/pkg/shared/*.test.js scripts/*.test.ts",
    "check": "tsc --noEmit",
    "check-schema": "pnpm run build && node dist/pkg/scripts/check-schema.js",
    "gen-schema": "pnpm run build && node dist/pkg/scripts/gen-schema.js",
    "gen-site": "pnpm run build && node dist/repo-tools/scripts/gen-site.js",
    "bump-version": "pnpm run build && node dist/pkg/scripts/bump-version.js",
    "deploy": "pnpm run gen-site && wrangler deploy",
    "deploy:dry": "pnpm run gen-site && wrangler deploy --dry-run",
    "prepack": "pnpm run build && node scripts/prepare-package.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "update:actions": "pnpm update --include-github-actions --latest actions/checkout actions/setup-node pnpm/action-setup",
    "check-package": "node scripts/check-package.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@valibot/to-json-schema": "^1.7.1",
    "create-desktop-shortcuts": "^1.11.1",
    "esbuild": "^0.28.2",
    "ofetch": "^1.5.1",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "valibot": "^1.4.2",
    "wrangler": "^4.156.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/patdx/ppkg.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@12.16.1"
}
